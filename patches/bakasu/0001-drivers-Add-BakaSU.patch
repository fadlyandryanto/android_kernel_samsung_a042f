From a758225dcdc5b6d3052e94011247964955540d20 Mon Sep 17 00:00:00 2001
From: fadlyandryanto <fa.andryanto@gmail.com>
Date: Fri, 9 Oct 2026 03:20:30 +0800
Subject: [PATCH 1/4] drivers: Add BakaSU

---
 .gitmodules      | 3 +++
 KernelSU         | 1 +
 drivers/Kconfig  | 1 +
 drivers/Makefile | 2 ++
 drivers/kernelsu | 1 +
 5 files changed, 8 insertions(+)
 create mode 100644 .gitmodules
 create mode 160000 KernelSU
 create mode 120000 drivers/kernelsu

diff --git a/.gitmodules b/.gitmodules
new file mode 100644
index 000000000000..ba67d23c4496
--- /dev/null
+++ b/.gitmodules
@@ -0,0 +1,3 @@
+[submodule "KernelSU"]
+	path = KernelSU
+	url = https://github.com/Baka-SU/BakaSU
diff --git a/KernelSU b/KernelSU
new file mode 160000
index 000000000000..8450dd287ef6
--- /dev/null
+++ b/KernelSU
@@ -0,0 +1 @@
+Subproject commit 8450dd287ef6ee25ca2b6b858b43c9354c73060c
diff --git a/drivers/Kconfig b/drivers/Kconfig
index 08c4e1a26185..d343eb22af19 100644
--- a/drivers/Kconfig
+++ b/drivers/Kconfig
@@ -233,4 +233,5 @@ source "drivers/samsung/Kconfig"
 
 source "drivers/battery/Kconfig"
 
+source "drivers/kernelsu/Kconfig"
 endmenu
diff --git a/drivers/Makefile b/drivers/Makefile
index f3369c6686ea..f77284d7d28e 100644
--- a/drivers/Makefile
+++ b/drivers/Makefile
@@ -195,3 +195,5 @@ obj-$(CONFIG_USE_MUIC)		+= muic/
 obj-$(CONFIG_SWITCH)		+= switch/
 obj-$(CONFIG_SEC_EXT)	+= samsung/
 obj-$(CONFIG_BATTERY_SAMSUNG)   += battery/
+
+obj-$(CONFIG_KSU) += kernelsu/
diff --git a/drivers/kernelsu b/drivers/kernelsu
new file mode 120000
index 000000000000..9e51d0d62734
--- /dev/null
+++ b/drivers/kernelsu
@@ -0,0 +1 @@
+../KernelSU/kernel
\ No newline at end of file
